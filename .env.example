# Copy to .env for local dev (netlify dev reads this). Never commit the real .env file.
# In production, set these in Netlify: Site settings > Environment variables.

ANTHROPIC_API_KEY=sk-ant-...

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Frontend only — points to your deployed Cloudflare Worker.
# Leave unset to fall back to Netlify Functions at /api/* instead.
VITE_API_BASE_URL=https://fellowship-scorer-api.your-subdomain.workers.dev
